# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Podcast Generator тохиргооны загвар
# Энэ файлыг хуулж ".env" нэрээр хадгалаад утгуудыг оруулна уу.
# Эсвэл Gradio UI → ⚙️ Тохиргоо таб-аас шууд оруулж болно.
# ══════════════════════════════════════════════════════════════════════════════

# ── 🎙️ Inworld TTS-2 ──────────────────────────────────────────────────────────
# https://studio.inworld.ai → API Keys
INWORLD_API_KEY=

# Дуу хоолой ID (Inworld Studio-оос авна)
INWORLD_VOICE_ID=en-US-Neural2-D

# Хэл (Монгол: mn-MN, Англи: en-US гэх мэт)
INWORLD_LANGUAGE=mn-MN

# Chunk зорилтот хэмжээ (Inworld хязгаар 2000, доод тал 1600 хэрэглэхийг зөвлөнө)
INWORLD_CHUNK_TARGET=1600

# ── 🤖 xAI Grok (промпт үүсгэгч) ─────────────────────────────────────────────
# https://console.x.ai → API Keys
XAI_API_KEY=

# Загвар: grok-3-latest, grok-3-mini-latest гэх мэт
XAI_MODEL=grok-3-latest

# Creativity (0.0–1.0, зургийн промптод 0.7–0.85 тохиромжтой)
XAI_PROMPT_TEMPERATURE=0.75

# ── ☁️ RunPod Serverless (Flux.1 Klein зураг үүсгэгч) ────────────────────────
# https://www.runpod.io/console/user/settings → API Keys
RUNPOD_API_KEY=

# Serverless Endpoints → Flux.1 endpoint → ID хуулна
RUNPOD_FLUX_ENDPOINT_ID=

# Зургийн хэмжээ (16:9 → 1920×1080 эсвэл 1280×720)
RUNPOD_FLUX_WIDTH=1920
RUNPOD_FLUX_HEIGHT=1080

# Inference чанар (алхам ихсэх тусам удаан, гоё → 20-30 тохиромжтой)
RUNPOD_FLUX_STEPS=20
RUNPOD_FLUX_GUIDANCE=7.5

# Нэг зурагт хүлээх хамгийн урт хугацаа (секунд)
RUNPOD_FLUX_TIMEOUT=300

# ── 🖥️ RunPod Pod (InfiniteTalk + FFmpeg рэндэр) ─────────────────────────────
# Pod ID (runpod.io/console/pods → таны Pod-ийн ID)
RUNPOD_POD_ID=

# Pod дэх API key (serverless-аас өөр байж болно)
RUNPOD_POD_API_KEY=

# RunPod Volume mount path (Pod болон Serverless хоёулаа харах volume)
RUNPOD_VOLUME_PATH=/runpod-volume/podcast

# ── 🗣️ InfiniteTalk (ярьдаг толгой) ──────────────────────────────────────────
# Pod дэх InfiniteTalk API endpoint (http://pod-ip:8080 гэх мэт)
INFINITETALK_ENDPOINT=

# Аватарын зураг (volume дэх байршил)
INFINITETALK_AVATAR_IMAGE=/runpod-volume/podcast/avatar.png

# Аватар видеоны хэмжээ (видеоны нийт нягтралын хэдэн хувь — 0.22 = 22%)
TALKING_HEAD_SCALE=0.22

# Баруун доод буланаас авах зай (пиксел)
TALKING_HEAD_MARGIN=20

# ── 🎬 Видео гаралт ────────────────────────────────────────────────────────────
OUTPUT_VIDEO_WIDTH=1920
OUTPUT_VIDEO_HEIGHT=1080
OUTPUT_FPS=30
OUTPUT_VIDEO_BITRATE=8M
OUTPUT_AUDIO_BITRATE=192k

# Гаралтын файлуудын хавтас (volume дотор)
OUTPUT_DIR=/runpod-volume/podcast/output

# Боловсруулалтын түр хавтас
TEMP_DIR=/tmp/podcast_tmp
